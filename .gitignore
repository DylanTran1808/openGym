media/img/
media/gif/

# Runtime data — users, passkeys, per-user state, session secret
data/

# Local config
.env

# Build output / deps
frontend/dist/
node_modules/
*.log
.DS_Store
node_modules
.claude/
.agents/
.superpowers/

# Nix build result symlinks
result
result-*

# CI reports (test:* jobs write these next to the suites)
junit.xml
coverage/
frontend/bundle-size.json

# Local planning notes
docs/superpowers/plans/

# gettingprime: NEVO (Dutch food table) dishes, built locally by scripts/build-dishes.mjs --nevo.
# Its terms are per user and allow no redistribution of changed data: never commit it.
frontend/public/dishes-nevo.json
# gettingprime: gp.sh keeps the pid of its caffeinate here.
.gp-caffeinate
